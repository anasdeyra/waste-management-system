# Toolchain used by the prototype.
#
# The toolchain is installed per user (no root access is required on the development
# machine). `tools/setup-toolchain.sh` performs the installation; the variables below are
# the ones the build and the metric scripts rely on.

JAVA_HOME=$HOME/.local/opt/jdk-21
MAVEN_HOME=$HOME/.local/opt/maven
NODE_VERSION=22.18.0
FRONTEND_DIR=frontend
BACKEND_DIR=backend
