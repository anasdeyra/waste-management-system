<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>3.5.16</version>
    <relativePath/>
  </parent>

  <groupId>com.ase</groupId>
  <artifactId>wastems-backend</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <name>WasteMS Backend</name>
  <description>REST API of the Intelligent Waste Management System prototype</description>

  <properties>
    <java.version>21</java.version>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
  </properties>

  <dependencies>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-data-jpa</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-security</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-validation</artifactId>
    </dependency>

    <!-- Embedded road routing on the versioned OSM snapshot (D-021, D-037). The XML data format
         is excluded so Spring MVC does not register an XML message converter. -->
    <dependency>
      <groupId>com.graphhopper</groupId>
      <artifactId>graphhopper-core</artifactId>
      <version>11.1</version>
      <exclusions>
        <exclusion>
          <groupId>com.fasterxml.jackson.dataformat</groupId>
          <artifactId>jackson-dataformat-xml</artifactId>
        </exclusion>
      </exclusions>
    </dependency>

    <dependency>
      <groupId>com.h2database</groupId>
      <artifactId>h2</artifactId>
      <scope>runtime</scope>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.springframework.security</groupId>
      <artifactId>spring-security-test</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
      </plugin>
    </plugins>
  </build>

  <profiles>
    <!--
      Static analysis tooling for Part 6 (software metrology).
      Run explicitly with `mvn -Pmetrics verify`; the default build stays fast.
    -->
    <profile>
      <id>metrics</id>
      <build>
        <plugins>
          <!--
            JDepend runs first so that the coupling report is produced even when the
            PMD quality gate fails the build.
          -->
          <plugin>
            <groupId>org.codehaus.mojo</groupId>
            <artifactId>jdepend-maven-plugin</artifactId>
            <version>2.1</version>
            <!--
              jdepend 2.9.1 (the plugin's default) cannot read Java 8+ constant-pool entries
              ("Unknown constant: 18") and silently skips most Java 21 classes; the maintained
              fork reads them (D-051).
            -->
            <dependencies>
              <dependency>
                <groupId>guru.nidi</groupId>
                <artifactId>jdepend</artifactId>
                <version>2.9.5</version>
              </dependency>
            </dependencies>
            <executions>
              <execution>
                <id>jdepend-analysis</id>
                <phase>verify</phase>
                <goals>
                  <goal>generate</goal>
                </goals>
              </execution>
            </executions>
          </plugin>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-pmd-plugin</artifactId>
            <version>3.28.0</version>
            <configuration>
              <rulesets>
                <ruleset>/rulesets/java/maven-pmd-plugin-default.xml</ruleset>
                <ruleset>${project.basedir}/../tools/pmd/wastems-ruleset.xml</ruleset>
              </rulesets>
              <targetJdk>21</targetJdk>
              <printFailingErrors>true</printFailingErrors>
              <!--
                The report is always produced. Use
                `mvn -Pmetrics -Dpmd.failOnViolation=true verify` to turn the rule
                violations into a build failure.
              -->
              <failOnViolation>false</failOnViolation>
            </configuration>
            <executions>
              <execution>
                <id>pmd-report</id>
                <phase>verify</phase>
                <goals>
                  <goal>pmd</goal>
                </goals>
              </execution>
              <execution>
                <!-- Every method's cyclomatic complexity (distribution for docs/06-metrics.md). -->
                <id>pmd-cc-all</id>
                <phase>verify</phase>
                <goals>
                  <goal>pmd</goal>
                </goals>
                <configuration>
                  <targetDirectory>${project.build.directory}/pmd-cc-all</targetDirectory>
                  <rulesets>
                    <ruleset>${project.basedir}/../tools/pmd/wastems-cc-all.xml</ruleset>
                  </rulesets>
                </configuration>
              </execution>
              <execution>
                <!--
                  Quality gate: fails the build when a rule is violated. Run it with
                  `mvn -Pmetrics -Dpmd.failOnViolation=true verify`.
                -->
                <id>pmd-check</id>
                <phase>verify</phase>
                <goals>
                  <goal>check</goal>
                </goals>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>
